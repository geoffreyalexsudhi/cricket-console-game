# Flask Configuration
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development
PORT=5005

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cricket

# Fallback Configuration (If MySQL is unavailable, uses local SQLite database for development/testing)
ENABLE_SQLITE_FALLBACK=true
